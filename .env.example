# 🌱 Plate2Place 2.0 Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# 🗄️ DATABASE CONFIGURATION
# ========================================
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/plate2place

# ========================================
# 🔐 AUTHENTICATION
# ========================================
# NextAuth.js configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-this-in-production

# JWT Secret for backend authentication
JWT_SECRET=your-jwt-secret-here-change-this-in-production

# ========================================
# 🌐 SOCIAL LOGIN (Optional)
# ========================================
# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# 📧 EMAIL CONFIGURATION
# ========================================
# SMTP configuration for email notifications
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password

# ========================================
# 🖼️ IMAGE STORAGE
# ========================================
# Cloudinary configuration for image uploads
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ========================================
# 🤖 AI SERVICES
# ========================================
# OpenAI API key for AI features
OPENAI_API_KEY=your-openai-api-key-here

# ========================================
# 🔧 APPLICATION SETTINGS
# ========================================
# Server port (backend)
SERVER_PORT=5000

# ========================================
# 🗺️ MAPS
# ========================================
# Using free OpenStreetMap with Leaflet.js
# No API key required!